{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse-labs.github.io/repo-standards/schemas/task-registry.schema.json",
  "title": "StegVerse Orchestration Task Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "org",
    "repo",
    "registry_type",
    "active_goal",
    "tasks",
    "archive_status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "org": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "registry_type": {
      "type": "string",
      "const": "orchestration_task_registry"
    },
    "active_goal": {
      "type": "string",
      "minLength": 1
    },
    "latest_readme_commit": {
      "type": "string"
    },
    "latest_release_readiness_commit": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "issue",
          "title",
          "status",
          "workstream",
          "depends_on",
          "outputs",
          "cosv"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "issue_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "claimed",
              "in_progress",
              "validating",
              "complete",
              "merged",
              "archived",
              "blocked"
            ]
          },
          "workstream": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tag_allowed": {
            "type": "boolean"
          },
          "activation_condition": {
            "type": "string"
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repository_artifact_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pull_request",
                "state",
                "role"
              ],
              "properties": {
                "pull_request": {
                  "type": "integer",
                  "minimum": 1
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "OPEN",
                    "MERGED",
                    "CLOSED"
                  ]
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "unresolved_obligations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cosv": {
            "type": "object",
            "description": "The task's COSV task.v1 projection, derived by tools/derive_task_registry_cosv.py. Shaped to the canonical cosv_record contract so it projects with no transformation. COSV is owned by StegVerse-Labs/.github; this is a projection and allocates nothing.",
            "required": [
              "identity",
              "profile",
              "level",
              "vector",
              "observed_at",
              "evidence_refs",
              "exact_metrics",
              "derivation"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "const": "task.v1"
              },
              "level": {
                "const": "task"
              },
              "vector": {
                "type": "string",
                "pattern": "^[0-9][0-2][0-9]{6}[0-2]{2}[0-9][0-2]{3}$",
                "description": "A task.v1 vector: fourteen digits, with positions 1, 8, 9, 11, 12 and 13 restricted to the canonical ternary domain (0 false, 1 true, 2 unknown). A bare ^[0-9]{14}$ admits 19000000020122, which canonical validate_vector rejects."
              },
              "observed_at": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exact_metrics": {
                "type": "object",
                "minProperties": 14
              },
              "derivation": {
                "type": "object",
                "required": [
                  "derived_by",
                  "profile_binding",
                  "profile_source_commit",
                  "authority_effect"
                ],
                "properties": {
                  "derived_by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile_binding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "profile_source_commit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authority_effect": {
                    "const": "PROJECTION_ONLY"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "cosv_declared": {
            "type": "object",
            "description": "Metrics the registry declares because they cannot be observed from this repository. Only names listed in config/cosv-task-profile.json declarable_metrics are admitted; the deriver refuses any other.",
            "additionalProperties": {
              "type": [
                "integer",
                "boolean",
                "null"
              ]
            }
          },
          "completion_evidence": {
            "type": "object",
            "description": "The evidence class a terminal status proves, per StegVerse-Labs/.github data/task-registry-global-invariants.json completion evidence contract v1 (NO_UNQUALIFIED_COMPLETE_OR_COMPLETED_STATUS). The class is the strongest one the cited evidence natively proves; a stronger class is never inferred from a weaker one.",
            "additionalProperties": false,
            "required": [
              "contract_version",
              "evidence_class",
              "evidence_refs"
            ],
            "properties": {
              "contract_version": {
                "type": "string",
                "const": "v1"
              },
              "evidence_class": {
                "type": "string",
                "enum": [
                  "SOURCE_IMPLEMENTED",
                  "MERGED",
                  "CI_VALIDATED",
                  "SANDBOX_RUNTIME_OBSERVED",
                  "EXTERNAL_PROVIDER_OBSERVED",
                  "MASTER_RECORDS_RECONSTRUCTED",
                  "END_TO_END"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "issue": {
                  "type": "null"
                }
              },
              "required": [
                "issue"
              ]
            },
            "then": {
              "required": [
                "issue_refs"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "complete",
                    "merged",
                    "archived"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "completion_evidence"
              ]
            }
          }
        ]
      }
    },
    "archive_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "READY_FOR_HANDOFF",
        "READY_FOR_ARCHIVE"
      ]
    }
  }
}
