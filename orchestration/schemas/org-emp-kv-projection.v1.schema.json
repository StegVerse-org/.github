{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-org/.github/orchestration/schemas/org-emp-kv-projection.v1.schema.json",
  "title": "StegVerse Org-Emp-KV projection (proposed v1)",
  "description": "Proposed contract for the organizational projection a WorkSpace Org gate reads. It declares the shape only: the organizational runtime produces the projection from its organization ledger and delivers it through Interlock/InTr. The projection is evidence, never authority (authority_effect NONE); a gate opens only when all five predicates are OBSERVED_TRUE, each backed by a receipt, under an admitted delivery. Absent or non-conforming projections fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projection_id",
    "organization",
    "principal_ref",
    "ledger",
    "predicates",
    "admission",
    "issued_at",
    "authority_effect"
  ],
  "properties": {
    "schema": { "const": "stegverse.org-emp-kv-projection/v1" },
    "projection_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$" },
    "organization": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$" },
    "principal_ref": {
      "description": "Opaque reference to the employee principal as the organization ledger records it; never a credential or personal datum.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "head_sha256"],
      "properties": {
        "root": { "const": "ORGANIZATION_LEDGER_ROOT" },
        "head_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "predicates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "employee_identity_matches",
        "machine_identity_matches",
        "active_membership",
        "role_capability_admitted",
        "transition_admitted"
      ],
      "properties": {
        "employee_identity_matches": { "$ref": "#/$defs/predicate" },
        "machine_identity_matches": { "$ref": "#/$defs/predicate" },
        "active_membership": { "$ref": "#/$defs/predicate" },
        "role_capability_admitted": { "$ref": "#/$defs/predicate" },
        "transition_admitted": { "$ref": "#/$defs/predicate" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_authority", "credential_authority", "receipt_ref"],
      "properties": {
        "transition_authority": { "const": "Interlock/InTr" },
        "credential_authority": { "const": "TV/TVC" },
        "receipt_ref": { "$ref": "#/$defs/receipt_ref" }
      }
    },
    "issued_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "authority_effect": { "const": "NONE" }
  },
  "$defs": {
    "receipt_ref": { "type": "string", "pattern": "^[A-Za-z0-9_./:#-]{1,240}$" },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "receipt_ref"],
      "properties": {
        "state": { "enum": ["OBSERVED_TRUE", "OBSERVED_FALSE", "NOT_OBSERVED"] },
        "receipt_ref": {
          "description": "Receipt of the ledger transition that established the state; null only when the state is NOT_OBSERVED.",
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9_./:#-]{1,240}$"
        }
      }
    }
  },
  "x-stegverse-gate-rule": {
    "gate_predicate": "ADMITTED_ORG_LEDGER_PROJECTION_SCHEMA_DECLARED",
    "opens_when": "every predicate state is OBSERVED_TRUE with a non-null receipt_ref and the projection conforms",
    "otherwise": {
      "disposition": "FAIL_CLOSED",
      "failure_code": "ORG_KV_PROJECTION_NOT_OBSERVED",
      "required_actionable_fields": [
        "failure_code",
        "failed_predicate",
        "required_evidence_or_repair",
        "retry_entrypoint",
        "owning_existing_goal",
        "next_attempt"
      ]
    },
    "storage_is_evidence": false,
    "status": "PROPOSED_OWNER_CHOOSES_BY_MERGE"
  }
}
