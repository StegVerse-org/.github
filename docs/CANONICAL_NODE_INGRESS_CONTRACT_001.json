  "solution_map": [
    {
      "finding": "PREDECESSOR_REQUIRED_BUT_LINEAGE_OPTIONAL",
      "solution": "Remove optional lineage semantics and normatively reuse SDK predecessor contract; predecessor presence is mandatory and null is explicit genesis only."
    },
    {
      "finding": "MUST_BIND_ADMITS_A_WALL_CLOCK",
      "solution": "Use heartbeat_epoch oscillator ordering only; wall-clock ordering is forbidden."
    },
    {
      "finding": "SINGLE_INGRESS_CONFLICTS_WITH_PORTABILITY_GOAL",
      "solution": "Require one canonical ingress contract, not one canonical host; deployment host is replaceable and non-authoritative."
    },
    {
      "finding": "MACHINE_LLM_ADAPTER_COLLAPSES_FRAMEWORK_AND_SURFACE",
      "solution": "Model framework/LLM as participant/consumer and surface/substrate/node/runtime as orthogonal dimensions."
    },
    {
      "finding": "ALREADY_ESTABLISHED_NODES_NOT_MODELED",
      "solution": "Add VERIFY_EXISTING standing path driven by mandatory predecessor lineage; failed verification never silently becomes genesis."
    },
    {
      "finding": "BROWSER_NOT_MODELED",
      "solution": "Add BROWSER as an explicit interaction-surface dimension without assuming StegBrowser semantics until its owner is proven."
    },
    {
      "finding": "NO_ATTESTATION_OWNER",
      "solution": "Retain NOT_PROVEN and FAIL_CLOSED; do not manufacture an attestation owner."
    },
    {
      "finding": "NO_TYPED_CONTINUATIONS_ADVERTISED",
      "solution": "Require mapping to existing advertised surfaces before any new endpoint is created."
    },
    {
      "finding": "BOUNDARY_CANNOT_CARRY_CANONICAL_PREDECESSOR",
      "solution": "Require a canonical predecessor carrier/validation seam using SDK semantics; do not equate lane-local receipt chaining with cross-lane predecessor standing."
    },
    {
      "finding": "LIVE_GATEWAY_ACCEPTS_CALLER_FABRICATED_IDENTITY",
      "solution": "Mark noncompliant; receiving boundary must validate canonical standing before processing."
    },
    {
      "finding": "MESSAGE_KEYWORD_ROUTE_SELECTION",
      "solution": "Forbid message-content processing selection; preserve manifest capability + route_id as the only processing selector."
    },
    {
      "finding": "COSV_UNRESOLVABLE_BY_CONSTRUCTION",
      "solution": "Record ABSENT_FROM_CURRENT_TASK_REGISTRY_SCHEMA; do not invent COSV."
    }
  ],
