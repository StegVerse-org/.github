{
 "authority_effect": "NONE",
 "core": {
  "inputs": [],
  "surfaces": [
   ".stegverse/test-suite-baseline/**",
   "resident-runtime/required_verification.py"
  ],
  "tests": [
   "tests/test_required_verification.py"
  ]
 },
 "import_roots": [
  "orchestration",
  "org-boundary",
  "org-kernel",
  "org-runtime",
  "resident-runtime",
  "tests",
  "vendor"
 ],
 "inputs": {
  "jsonschema": {
   "check": {
    "kind": "python_module",
    "module": "jsonschema"
   },
   "finish_point": "the full-suite job imports jsonschema and tests/test_stdlib_json_schema_agreement.py (the stdlib validator's agreement oracle) runs and passes at the exact head",
   "owner": "StegVerse-org/.github#166 (P4 lane: the agreement oracle only; every other schema check uses the pinned stdlib validator)",
   "repair": "the full-suite job installs jsonschema (python -m pip install \"jsonschema==4.26.0\", the version the agreement oracle is qualified at) for the agreement check only"
  },
  "labs-stdlib-json-schema": {
   "check": {
    "env": "STEGVERSE_LABS_ROOT",
    "kind": "env_path"
   },
   "finish_point": "STEGVERSE_LABS_ROOT names the pinned StegVerse-Labs checkout (sha256-checked) and the schema-conformance tests run and pass at the exact head",
   "owner": "StegVerse-org/.github#166 (P4 lane: wired in required-verification.yml full-suite)",
   "repair": "the job fetches the commit in .stegverse/test-suite-baseline/labs-tool-pin.json (resident-runtime/pinned_labs.py fetch) and sets STEGVERSE_LABS_ROOT"
  },
  "ledger-store-step-b": {
   "check": {
    "kind": "unavailable",
    "reason": "P1-FC-12 step (b) (readback and writers re-raising the remote-locator refusal in six fields) is deferred until StegVerse-org/.github#189 lands; the tests are @unittest.skip until then"
   },
   "finish_point": "#189 is on main and both tests run unskipped and pass at the exact head",
   "owner": "Lane C/D (ledger store; StegVerse-org/.github#189, #162)",
   "repair": "land StegVerse-org/.github#189, remove the @unittest.skip decorators and this input from the set"
  },
  "organization-ledger-ref": {
   "check": {
    "kind": "git_ref",
    "ref": "refs/stegverse/organization-ledger"
   },
   "finish_point": "the checkout holds the ledger ref and the InTr path and merge-transfer tests run and pass at the exact head",
   "owner": "Lane C/D (organization ledger store; StegVerse-org/.github#162)",
   "repair": "the full-suite job fetches refs/stegverse/organization-ledger read-only, as intr-path-transfer-validation.yml does"
  },
  "repo-standards": {
   "check": {
    "env": "REPO_STANDARDS_ROOT",
    "kind": "env_path"
   },
   "finish_point": "REPO_STANDARDS_ROOT names a repo-standards checkout and OwnerDriftTests run and pass at the exact head",
   "owner": "TVC-PRIVATE-SOURCE-READ-001 (GitHub Product)",
   "repair": "a read of the private repo-standards repository supplied as REPO_STANDARDS_ROOT through a sanctioned private-source read (no credential is routed around)"
  },
  "stegverse-sdk": {
   "check": {
    "kind": "python_module",
    "module": "stegverse"
   },
   "finish_point": "required-verification.yml full-suite imports the pinned stegverse SDK and the set's tests run and pass at the exact head",
   "owner": "P1 (StegVerse-org/.github#163)",
   "repair": "the pinned StegVerse SDK installed in required-verification.yml full-suite (8 workflows here already check out StegVerse-SDK and pip install -e it; P1 decides whether the full-suite job does the same)"
  },
  "tvc": {
   "check": {
    "env": "STEGVERSE_TVC_ROOT",
    "kind": "env_path"
   },
   "finish_point": "STEGVERSE_TVC_ROOT names a TVC checkout in the full-suite job and the conformance exchange tests run and pass at the exact head",
   "owner": "GitHub Product, Lane C (StegVerse-org/.github#164)",
   "repair": "a TV/TVC checkout supplied as STEGVERSE_TVC_ROOT to the full-suite job"
  }
 },
