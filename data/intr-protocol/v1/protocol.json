{
  "schema": "stegverse.intr-protocol-contract/v1",
  "protocol": "stegverse.intr-protocol/v1",
  "protocol_version": 1,
  "owner_repository": "StegVerse-org/.github",
  "owning_existing_goal": "StegVerse-org/.github#162",
  "validator": "org-runtime/intr_protocol.py",
  "retry_entrypoint": "python org-runtime/intr_protocol.py conform --org <ORG> --interlock <interlock-intr.json> --services <services.json>",
  "authority_effect": "NONE_CONFORMANCE_EVIDENCE_ONLY",
  "dispositions": ["ALLOW", "DENY", "FAIL_CLOSED"],
  "non_allow_fields": ["failure_code", "failed_predicate", "required_evidence_or_repair", "retry_entrypoint", "owning_existing_goal", "next_attempt"],
  "disposition_rule": {
    "ALLOW": "every predicate observed and equal to the contract",
    "DENY": "an observed value differs from the contract",
    "FAIL_CLOSED": "a required document, field or version is absent or unknown, so the predicate is unobserved"
  },
  "message": {
    "schema_ref": "stegverse.intr-message/v1",
    "message_class": "ecosystem.communication",
    "required": {
      "message_class": "EQUALS:ecosystem.communication",
      "communication_id": "NON_EMPTY_PRINTABLE_TOKEN",
      "body": "OBJECT",
      "body.schema": "EQUALS_DESTINATION_PAYLOAD_SCHEMA"
    }
  },
  "route": {
    "schema_ref": "stegverse.intr-route/v1",
    "address_form": "ORGANIZATION_SLUG_DOT_CAPABILITY_PROFILE_ID",
    "slug_derivation": "org-kernel/kernel.py::organization_slug",
    "transport": "INTERLOCK_INTR",
    "host_required": false,
    "environment_url_required": false,
    "credential_authority": "TV/TVC",
    "github_token_runtime_authority": "NONE",
    "route_is_routing_authority": false
  },
  "destination_capability": {
    "schema_ref": "stegverse.intr-destination-capability/v1",
    "profile_id": "intr-destination",
    "interlock_document": "org-runtime/interlock-intr.json",
    "service_registry_document": "org-boundary/registry/services.json",
    "interlock_schema": "stegverse.organization-interlock-intr-boundary/v1",
    "interlock_predicates": [
      {"id": "INTERLOCK_SCHEMA_IS_V1", "path": "schema", "equals": "stegverse.organization-interlock-intr-boundary/v1", "unknown": "FAIL_CLOSED"},
      {"id": "INTERLOCK_IS_THIS_ORGANIZATION", "path": "organization", "equals": "$ORG"},
      {"id": "INTERLOCK_CREDENTIAL_AUTHORITY_IS_TV_TVC", "path": "credential_authority", "equals": "TV/TVC"},
      {"id": "INTERLOCK_GITHUB_TOKEN_HAS_NO_RUNTIME_AUTHORITY", "path": "github_token_runtime_authority", "equals": "NONE"},
      {"id": "INGRESS_REQUIRES_INTERLOCK", "path": "ingress.interlock_required", "equals": true},
      {"id": "INGRESS_REQUIRES_INTR", "path": "ingress.intr_required", "equals": true},
      {"id": "EGRESS_REQUIRES_INTERLOCK", "path": "egress.interlock_required", "equals": true},
      {"id": "EGRESS_REQUIRES_INTR", "path": "egress.intr_required", "equals": true},
      {"id": "PEER_ADDRESS_FORM_IS_SLUG_DOT_PROFILE", "path": "egress.peer_capability_resolution.address_form", "equals": "ORGANIZATION_SLUG_DOT_CAPABILITY_PROFILE_ID"}
    ],
    "binding_predicates": [
      {"id": "BINDING_PROFILE_NAME", "path": "profile_name", "equals": "InTr:Destination"},
      {"id": "BINDING_OPERATION", "path": "operation", "equals": "DIAGNOSTIC_CROSSING"},
      {"id": "BINDING_PAYLOAD_SCHEMA", "path": "payload_schema", "equals": "stegverse.org-intr-destination-diagnostic/v1"},
      {"id": "BINDING_DECLARED_BY_THIS_ORGANIZATION", "path": "capability_declaration_owner", "equals": "$REPO"},
      {"id": "BINDING_OWNED_BY_THIS_ORGANIZATION", "path": "capability_binding_owner", "equals": "$REPO"},
      {"id": "BINDING_AUTHORITY_EFFECT_IS_NONE", "path": "authority_effect", "equals": "NONE_BINDING_ONLY"},
      {"id": "BINDING_INGRESS_IS_NOT_ENVIRONMENT_SELECTED", "path": "environment_selected_ingress", "equals": false},
      {"id": "RECEIVER_OWNED_BY_THIS_ORGANIZATION", "path": "receiving_operation.owner_repository", "equals": "$REPO"},
      {"id": "RECEIVER_OPERATION_ID", "path": "receiving_operation.operation_id", "equals": "ORGANIZATION_INTR_DESTINATION_INGRESS"},
      {"id": "RECEIVER_OPERATION_PATH", "path": "receiving_operation.operation", "equals": "resident-runtime/intr_destination_ingress.py"},
      {"id": "RECEIVER_ADDRESS_DERIVES_FROM_ORGANIZATION", "path": "receiving_operation.addressed_service", "equals": "$ADDRESS"},
      {"id": "RECEIVER_ADDRESS_RESOLVES_FROM_REGISTRY", "path": "receiving_operation.address_is_resolvable_from_the_service_registry", "equals": true},
      {"id": "RECEIVER_ADDRESS_DOES_NOT_SELECT_PROCESSING", "path": "receiving_operation.selects_processing_at_the_capability_address", "equals": false},
      {"id": "RECEIVER_TRANSPORT_IS_INTERLOCK_INTR", "path": "receiving_operation.transport", "equals": "INTERLOCK_INTR"},
      {"id": "RECEIVER_ADDRESS_IS_NOT_HOST_OR_URL", "path": "receiving_operation.address_form", "equals": "REPOSITORY_OWNED_OPERATION_NOT_HOST_OR_URL"},
      {"id": "RECEIVER_NEEDS_NO_HOST", "path": "receiving_operation.host_required", "equals": false},
      {"id": "RECEIVER_NEEDS_NO_ENVIRONMENT_URL", "path": "receiving_operation.environment_url_required", "equals": false},
      {"id": "RECEIVER_CREDENTIAL_AUTHORITY_IS_TV_TVC", "path": "receiving_operation.credential_authority", "equals": "TV/TVC"},
      {"id": "RECEIVER_GITHUB_TOKEN_HAS_NO_RUNTIME_AUTHORITY", "path": "receiving_operation.github_token_runtime_authority", "equals": "NONE"},
      {"id": "RECEIVER_EMITS_TRANSITION_RECEIPT", "path": "receiving_operation.emits", "equals": "stegverse.organization-transition-receipt/v1"}
    ],
    "service_predicates": [
      {"id": "SERVICE_REGISTRY_IS_THIS_ORGANIZATION", "path": "organization", "equals": "$ORG"},
      {"id": "SERVICE_REPOSITORY_IS_THIS_ORGANIZATION", "row_path": "repository", "equals": "$REPO"},
      {"id": "SERVICE_PROFILE_IS_INTR_DESTINATION", "row_path": "capability_profile_id", "equals": "intr-destination"},
      {"id": "SERVICE_ROLE_IS_BOUNDARY_LOCAL_INGRESS", "row_path": "boundary_role", "equals": "BOUNDARY_LOCAL_CAPABILITY_INGRESS"},
      {"id": "SERVICE_ACCEPTS_ECOSYSTEM_COMMUNICATION", "row_path": "accepts", "contains": "ecosystem.communication"},
      {"id": "SERVICE_ACCEPTS_DESTINATION_PAYLOAD", "row_path": "accepts", "contains": "stegverse.org-intr-destination-diagnostic/v1"},
      {"id": "SERVICE_DOES_NOT_SELECT_PROCESSING", "row_path": "selects_processing_at_this_address", "equals": false}
    ]
  }
}
