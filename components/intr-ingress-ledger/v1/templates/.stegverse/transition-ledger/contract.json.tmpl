{
  "schema": "stegverse.repo-transition-ledger-contract/v1",
  "repository": "{{REPOSITORY}}",
  "ledger_level": "REPOSITORY",
  "receipt_schema": "stegverse.repo-transition-receipt/v1",
  "append_only_receipts": true,
  "required_fields": [
    "repository",
    "transition_id",
    "transition_class",
    "predecessor_state_sha256",
    "successor_state_sha256",
    "evidence",
    "authority_effect",
    "hb_reference",
    "previous_receipt_sha256"
  ],
  "replay_rule": "REPOSITORY_REPLAY_MUST_NOT_REQUIRE_ORGANIZATION_OR_ECOSYSTEM_REPLAY",
  "repository_ledger_location": {
    "repository": "{{REPOSITORY}}",
    "ref": "refs/stegverse/organization-ledger",
    "namespace": "repository-ledger/{{REPOSITORY}}",
    "locator_form": "git+<checkout>#refs/stegverse/organization-ledger:repository-ledger/{{REPOSITORY}}",
    "new_ledger_root": false,
    "designation_source": "org-contract.json organization_ledger_ref; preserves_repo_receipt: true",
    "rule": "The repository chain is kept in its own subtree of the designated organization ledger ref, published by the same fast-forward push under ORGANIZATION_LEDGER_LOCK. Repository replay walks repository-ledger/<repository>/HEAD.json back through its own receipts and never reads an organization receipt."
  },
  "propagation_rule": "PROPAGATE_ONLY_EVIDENCE_NEEDED_BY_NEXT_HIGHER_LEVEL",
  "authority_effect": "NONE_CONTRACT_ONLY"
}
